# Copy this file to .env.local and change what you need.
# Everything works locally with the values below. Nothing here is required
# except ADMIN_PASSWORD (or ADMIN_PASSWORD_HASH) for the /admin page.

# ── Site ────────────────────────────────────────────────────────────────
# Public URL, used for the sitemap, Open Graph tags and links in emails.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin (/admin) ──────────────────────────────────────────────────────
# Demo password for local use. Change it for anything public.
ADMIN_PASSWORD=saffron-demo
# Better for production: store only a hash. Create one with
#   npm run hash-password -- "your-password"
# and paste it here (then remove ADMIN_PASSWORD).
# ADMIN_PASSWORD_HASH=
# Optional: shown under the sign-in form, handy for a public demo.
ADMIN_LOGIN_HINT="Demo password: saffron-demo"
# Optional: a long random string used to sign admin sessions. If unset,
# the password (or its hash) is used, so changing it signs everyone out.
# ADMIN_SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────────
# Leave empty to store bookings in .data/bookings.json (fine locally).
# For production, use Postgres, e.g. a free Neon or Supabase database.
# Tables are created automatically on first use.
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Connections per server instance (keep small on serverless hosts).
# DATABASE_POOL_MAX=5

# ── Email ───────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to print emails to the server log instead of
# sending them (HTML copies are saved in .data/outbox/).
# With a key from https://resend.com, real emails are sent. Until you
# verify a domain, Resend only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM="Saffron Table <onboarding@resend.dev>"
# Where new-booking notifications go.
OWNER_EMAIL=owner@example.com
